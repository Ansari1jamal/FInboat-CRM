NODE_ENV=production

POSTGRES_USER=finboat
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=finboat

DATABASE_URL=postgresql://finboat:replace_with_a_strong_database_password@postgres:5432/finboat

REDIS_PASSWORD=replace_with_a_strong_redis_password

JWT_SECRET=replace_with_output_from_openssl_rand_hex_64
JWT_EXPIRES_IN=15m
CSRF_SECRET=replace_with_a_long_random_value

FRONTEND_URL=https://finboat.com
DOCUMENT_STORAGE_PATH=storage/documents
LOG_LEVEL=info

SEED_ADMIN_NAME=FinBoat Admin
SEED_ADMIN_EMAIL=replace_with_admin_email
SEED_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_16_chars
