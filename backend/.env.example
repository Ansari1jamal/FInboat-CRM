NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/finboat-crm?schema=public"

JWT_SECRET="replace_with_a_unique_random_secret"
JWT_EXPIRES_IN=15m
CSRF_SECRET="replace_with_a_separate_unique_random_secret"

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

DOCUMENT_STORAGE_PATH=storage/documents
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# Development/demo seed only. Use unique local-only credentials.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace_with_a_local_only_password
SEED_MANAGER_EMAIL=manager@example.test
SEED_MANAGER_PASSWORD=replace_with_a_local_only_password
SEED_TL_EMAIL=tl@example.test
SEED_TL_PASSWORD=replace_with_a_local_only_password
SEED_TELECALLER_EMAIL=telecaller@example.test
SEED_TELECALLER_PASSWORD=replace_with_a_local_only_password
